        {
          "info": {
            "name": "Lightspeed Update a Webhook",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.trial.lsk.lightspeed.app/o/wh/1/webhook",
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "oauth2",
              "flow": "authorization_code",
              "authorizationUrl": "/oauth/authorize",
              "accessTokenUrl": "/oauth/token",
              "credentials": {
                "clientId": "{{clientId}}",
                "clientSecret": "{{clientSecret}}"
              }
            }
          },
          "docs": "Updates an existing webhook entry.\n\nImportant Note: if `provideAccount`, `expandTransactions`, or `expandPayments` are excluded from the update request, they will be reset to their default values."
        },
        {
          "info": {
            "name": "Lightspeed Create a Webhook",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "https://api.trial.lsk.lightspeed.app/o/wh/1/webhook",
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "oauth2",
              "flow": "authorization_code",
              "authorizationUrl": "/oauth/authorize",
              "accessTokenUrl": "/oauth/token",
              "credentials": {
                "clientId": "{{clientId}}",
                "clientSecret": "{{clientSecret}}"
              }
            }
          },
          "docs": "Configures a new webhook to be used for order status updates."
