{
  "opencollection": "1.0.0",
  "info": {
    "name": "Lightspeed Restaurant K Series Account Tax Breakdown API",
    "version": "1.0.0"
  },
  "items": [
    {
      "info": {
        "name": "Tax Breakdown",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Lightspeed Post Proposed Order",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.trial.lsk.lightspeed.app/tp/v1/business-locations/:businessLocationId/tax-breakdown",
            "params": [
              {
                "name": "businessLocationId",
                "value": "",
                "type": "path"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            },
            "auth": {
              "type": "oauth2",
              "flow": "authorization_code",
              "authorizationUrl": "/oauth/authorize",
              "accessTokenUrl": "/oauth/token",
              "credentials": {
                "clientId": "{{clientId}}",
                "clientSecret": "{{clientSecret}}"
              }
            }
          },
          "docs": "Returns the tax breakdown of a proposed order"
        }
      ]
    }
  ],
  "bundled": true
}